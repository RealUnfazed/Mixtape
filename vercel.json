{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'Nothing to build: public/assets/app.css is already compiled.'",
  "outputDirectory": "public",
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.4" }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": false }
  ]
}
