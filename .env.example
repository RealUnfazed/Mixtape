# Copy to .env and edit. Real environment variables take priority over this file.
# On Vercel you set these in Project Settings > Environment Variables instead; there is no .env file there.

APP_DEBUG=0
# Long random string that signs form tokens and hashes visitor IPs for rate limiting.
# Make one with:  php -r 'echo bin2hex(random_bytes(32)), "\n";'
APP_SECRET=
# Public base URL, only needed when the app sits behind a proxy that hides the real host or scheme.
APP_URL=
# Set to 1 only when a trusted reverse proxy sets X-Forwarded-Proto and X-Forwarded-For.
# Not needed on Vercel, which is detected automatically.
TRUST_PROXY=0

# Either one connection URL (Neon, Supabase and most hosts give you this)...
DATABASE_URL=postgres://mixtape:mixtape@127.0.0.1:5432/mixtape
# ...or separate settings (used when DATABASE_URL is empty):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mixtape
DB_USER=mixtape
DB_PASSWORD=mixtape
# Optional: require, prefer, disable. A hosted database usually needs require.
DB_SSLMODE=
# Optional: 1 or 0. By default prepared statements are emulated only for pooled hosts (PgBouncer).
DB_EMULATE_PREPARES=

MAX_SONGS=6
LETTER_MAX=1200
CREATE_LIMIT_PER_HOUR=10

# Optional. A YouTube Data API v3 key turns on "search by song name" in the builder.
# Without it, people paste YouTube links instead.
YOUTUBE_API_KEY=
